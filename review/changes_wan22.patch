++                    fb_t = handle.get_tensor(spec[fb]).to(device).float()
++                    return fa_t @ fb_t.reshape(fb_t.shape[0], -1)
++                w1 = factor("lokr_w1", "lokr_w1_a", "lokr_w1_b")
