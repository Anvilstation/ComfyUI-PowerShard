++        if has_effect(to_load):
++            raise ValueError("Сторонние to_load_options не поддерживаются")
++        rest = {k: v for k, v in options.items()
++                if k not in HOST_ONLY_TRANSFORMER_KEYS + ("rope_options", "callbacks", "patches", "patches_replace")}
++        if "wrappers" in rest:
