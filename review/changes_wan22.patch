++def nccl_timeout_minutes():
++    """Срок коллективов NCCL (watchdog завершает зависший rank). Длинные шаги не мешают: срок — на одну операцию."""
++    try:
++        return max(1., float(os.environ.get("POWERSHARD_NCCL_TIMEOUT_MIN", "60")))
++    except ValueError:
++        return 60.
