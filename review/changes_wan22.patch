+#!/usr/bin/env python3
+"""Детерминированные API графы LTX-2 / 2.3 / 2.5 (workflows_ltx/). Имена файлов моделей — замените на свои."""
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "workflows_ltx"
