++def fits_blocks(module, fmt):
++    k, n = module.in_features, module.out_features
++    if fmt in ("nvfp4", "mxfp8", "convrot_w4a4", "asym_w4a8_int8", "w6a8_int8"):
++        return k % 64 == 0 and n % 16 == 0 and n >= 64
++    return n >= 16
