++"""Tiny Wan headers/files без torch: safetensors пишется вручную (JSON header + raw bytes)."""
++import json
++import math
++import struct
++from pathlib import Path
++
++BYTES = {"F16": 2, "BF16": 2, "F32": 4, "F8_E4M3": 1, "U8": 1, "I8": 1}
