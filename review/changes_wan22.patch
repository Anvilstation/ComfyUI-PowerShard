+"""Image-модели: раскладка sequence parallel, выбор режима, ноды. Без torch/CUDA."""
+import random
+import subprocess
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def brute_local_positions(segments, world, rank):
+    from powershard.image_layout import split_sizes
+    out, start = [], 0
+    for n, split in segments:
+        if split:
+            sizes = split_sizes(n, world)
+            a = start + sum(sizes[:rank])
+            out += list(range(a, a + sizes[rank]))
+        else:
+            out += list(range(start, start + n))
+        start += n
+    return out
+
+
+def test_split_sizes_cover_and_balance():
+    from powershard.image_layout import split_sizes
+    for n in range(0, 40):
+        for world in range(1, 8):
+            sizes = split_sizes(n, world)
+            assert sum(sizes) == n and max(sizes) - min(sizes) <= 1
+
+
+def test_layout_matches_brute_force_and_remaps_ranges():
+    from powershard.image_layout import Layout
+    rng = random.Random(3)
+    for _ in range(300):
+        world = rng.randint(2, 7)
+        rank = rng.randrange(world)
+        segments = [(rng.randint(0, 9), False), (rng.randint(world, 60), True), (rng.randint(0, 9), False)]
+        rng.shuffle(segments)
+        lay = Layout(segments, world, rank)
+        positions = brute_local_positions(segments, world, rank)
+        assert lay.local_positions() == positions and lay.local_len == len(positions)
+        for _ in range(10):
+            s = rng.randint(0, lay.total)
+            e = rng.randint(s, lay.total)
+            # локальный интервал = локальные строки, попавшие в глобальный [s, e)
+            inside = [i for i, p in enumerate(positions) if s <= p < e]
+            got = lay.remap_ranges([(s, e, 7)])
+            if inside:
+                assert got == [(inside[0], inside[-1] + 1, 7)]
+            else:
+                assert got == []
+            assert lay.local_index(s) == sum(1 for p in positions if p < s)
+
+
+def test_layout_requires_one_split_segment():
+    from powershard.image_layout import Layout
+    with pytest.raises(ValueError):
+        Layout([(3, False), (5, False)], 2, 0)
+    with pytest.raises(ValueError):
+        Layout([(3, True), (5, True)], 2, 0)
+
+
+def test_choose_mode():
+    from powershard.image_layout import choose_mode
+    assert choose_mode("auto", True, 1, 6, 4096)[0] == "sequence"
+    assert choose_mode("auto", False, 2, 6, 4096)[0] == "batch"
+    assert choose_mode("auto", False, 1, 6, 4096)[0] == "replicate"
+    assert choose_mode("auto", True, 2, 6, 100)[0] == "batch"            # мало токенов на 6 GPU
+    assert choose_mode("sequence", False, 1, 6, 4096)[0] == "replicate"
+    assert choose_mode("batch", True, 1, 6, 4096)[0] == "replicate"
+    assert choose_mode("replicate", True, 4, 6, 4096)[0] == "replicate"
+    assert choose_mode("auto", True, 1, 1, 4096)[0] == "replicate"
+
+
+def _fake_folder_paths(monkeypatch):
+    fake = types.ModuleType("folder_paths")
+    fake.get_filename_list = lambda folder: [f"{folder}_a.safetensors"]
+    fake.get_full_path_or_raise = lambda folder, name: f"/models/{folder}/{name}"
+    fake.get_folder_paths = lambda folder: []
+    monkeypatch.setitem(sys.modules, "folder_paths", fake)
+    return fake
+
+
+def test_image_nodes_register_without_torch():
+    code = ("import sys; from powershard.common_nodes import COMMON_NODE_CLASS_MAPPINGS as n; "
+            "assert {'PowerShardImageLoader', 'PowerShardCheckpointCLIPVAE', 'PowerShardLoRA'} <= set(n); "
+            "import powershard.image_layout; assert 'torch' not in sys.modules")
+    subprocess.run([sys.executable, "-c", code], cwd=ROOT, check=True)
+
+
+def test_image_loader_inputs(monkeypatch):
+    _fake_folder_paths(monkeypatch)
+    from powershard.image_nodes import PowerShardImageLoader
+    fields = PowerShardImageLoader.INPUT_TYPES()
+    assert "checkpoints/checkpoints_a.safetensors" in fields["required"]["checkpoint"][0]
+    assert "diffusion_models/diffusion_models_a.safetensors" in fields["required"]["checkpoint"][0]
+    assert fields["required"]["parallel"][0] == ["auto", "sequence", "batch", "replicate"]
+    assert fields["optional"]["lora"][0] == "POWERSHARD_LORA"
+    assert fields["optional"]["weights"][0] == "POWERSHARD_WEIGHTS"
+
+
+def test_lora_type_is_shared_by_every_loader(monkeypatch):
+    _fake_folder_paths(monkeypatch)
+    from powershard.common_nodes import PowerShardLoRA
+    from powershard.ltx_nodes import LTX_NODE_CLASS_MAPPINGS
+    from powershard.wan_nodes import WAN_NODE_CLASS_MAPPINGS
+    for cls in (WAN_NODE_CLASS_MAPPINGS["PowerShardWanLoader"], WAN_NODE_CLASS_MAPPINGS["PowerShardWan22MoELoader"],
+                LTX_NODE_CLASS_MAPPINGS["PowerShardLTXLoader"], LTX_NODE_CLASS_MAPPINGS["PowerShardH3QuantLoader"]):
+        assert cls.INPUT_TYPES()["optional"]["lora"][0] == "POWERSHARD_LORA"
+    spec = PowerShardLoRA().add("loras_a.safetensors", 0.5)[0]
+    assert len(spec) == 1 and spec[0].strength == 0.5 and spec[0].apply_to == "all"
+    # старые Wan/LTX LoRA ноды скрыты, но открывают старые workflows
+    assert WAN_NODE_CLASS_MAPPINGS["PowerShardWanLoRA"].DEPRECATED
+    assert WAN_NODE_CLASS_MAPPINGS["PowerShardWanLoRA"].RETURN_TYPES == ("POWERSHARD_LORA",)
+    assert LTX_NODE_CLASS_MAPPINGS["PowerShardLTXLoRA"].DEPRECATED
+
+
+def test_text_encoder_image_types(monkeypatch):
+    _fake_folder_paths(monkeypatch)
+    from powershard.common_nodes import PowerShardTextEncoder, TEXT_ENCODERS
+    types_ = PowerShardTextEncoder.INPUT_TYPES()["required"]["type"][0]
+    for name in ("wan_umt5", "ltx_gemma", "flux", "flux2", "qwen_image", "z_image", "moss_image", "sdxl"):
+        assert name in types_
+    assert TEXT_ENCODERS["z_image"] == "lumina2" and TEXT_ENCODERS["sdxl"] == "stable_diffusion"
+    optional = PowerShardTextEncoder.INPUT_TYPES()["optional"]
+    assert optional["text_encoder_2"][0][0] == "none"
+    paths = PowerShardTextEncoder._paths("text_encoders_a.safetensors", "flux", "none",
+                                         ("text_encoders_a.safetensors", "none", "none"))
+    assert len(paths) == 2
+    with pytest.raises(ValueError, match="wan_umt5"):
+        PowerShardTextEncoder().load("text_encoders_a.safetensors", "wan_umt5", "workers", config=object(),
+                                     text_encoder_2="text_encoders_a.safetensors")
+
+
+def test_weights_fp32_only_for_image():
+    from powershard.common_nodes import PowerShardWeights, apply_weights
+    from powershard.wan_config import WanOptions
+    w = PowerShardWeights().create("dequantize", "auto", "fp32", False)[0]
+    assert w.weight_dtype == "fp32"
+    with pytest.raises(ValueError, match="image"):
+        apply_weights(WanOptions(), w)
+
+
+def test_decide_dtypes():
+    torch = pytest.importorskip("torch")
+    from powershard.image_adapter import decide_dtypes
+    v100, rtx = [(7, 0)] * 6, [(12, 0)] * 2
+    flux = [torch.bfloat16, torch.float16, torch.float32]
+    zimage = [torch.bfloat16, torch.float32]
+    assert decide_dtypes(flux, "auto", v100) == ("fp16", "fp16")
+    assert decide_dtypes(flux, "auto", rtx) == ("bf16", "bf16")
+    assert decide_dtypes(zimage, "auto", v100) == ("bf16", "fp32")      # bf16-модель на V100: точное FP32
+    assert decide_dtypes(zimage, "fp16", v100) == ("fp16", "fp16")      # явный выбор пользователя
+    assert decide_dtypes(zimage, "bf16", v100) == ("bf16", "fp32")
+    assert decide_dtypes(zimage, "auto", v100[:1] + rtx) == ("bf16", "fp32")
+
+
+def test_h3_pdd_shape(tmp_path):
+    pytest.importorskip("torch")
+    import json
+    from wan_fixtures import write_safetensors
+    from powershard.h3_quant import H3Checkpoint
+    tensors = {"video_patch_proj.weight": ("F16", [32, 8], None), "adaln_t_table": ("F32", [17, 4], None),
+               "blocks.0.attn.q_norm.weight": ("F16", [8], None), "blocks.0.attn.qkv_proj.weight": ("F16", [96, 32], None),
+               "blocks.0.mlp.fc1.weight": ("F16", [128, 32], None), "token_refiner.blocks.0.x.weight": ("F16", [4], None),
+               "condition_proj.weight": ("F16", [32, 24], None), "rope.inv_freq": ("F32", [1], None),
+               "final_layer.video_out.weight": ("F32", [4 * 24 * 3, 32], None),
+               "final_layer.audio_out.weight": ("F32", [32 * 3, 32], None)}
+    path = write_safetensors(tmp_path / "h3.safetensors", tensors,
+                             metadata={"config": json.dumps({"transformer": {"pdd_steps": 3}})})
+    conf = H3Checkpoint(path).model_config()
+    assert conf["pdd_steps"] == 3 and conf["latents_dim"] == 24 and conf["audio_latents_dim"] == 32
diff --git a/tests/test_image_parallel_torch.py b/tests/test_image_parallel_torch.py
new file mode 100644
index 0000000..63a2237
--- /dev/null
+++ b/tests/test_image_parallel_torch.py
@@ -0,0 +1,98 @@
+"""Sequence / batch parallel image-моделей против обычного forward (CPU, gloo, 2-3 процесса, родные модели ComfyUI).
+
+  python -m pytest tests/test_image_parallel_torch.py --comfy /path/to/ComfyUI
+"""
+import os
+import sys
+from pathlib import Path
+
+import pytest
+
+torch = pytest.importorskip("torch")
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _comfy(path):
+    sys.path.insert(0, str(Path(path).resolve()))
+    sys.path.insert(0, str(ROOT))
+    saved = sys.argv
+    sys.argv = ["powershard-test", "--cpu", "--disable-dynamic-vram", "--use-pytorch-cross-attention"]
+    try:
+        import comfy.options
+        comfy.options.enable_args_parsing()
+        import comfy.ops  # noqa: F401
+    finally:
+        sys.argv = saved
+
+
+def _build(family):
+    import comfy.ops
+    ops = comfy.ops.disable_weight_init
+    if family == "flux":
+        from comfy.ldm.flux.model import Flux
+        model = Flux(image_model="flux", in_channels=4, out_channels=4, vec_in_dim=8, context_in_dim=16, hidden_size=64,
+                     mlp_ratio=2.0, num_heads=4, depth=2, depth_single_blocks=2, axes_dim=[4, 6, 6], theta=10000,
+                     patch_size=2, qkv_bias=True, guidance_embed=False, txt_ids_dims=[], dtype=torch.float32,
+                     device="cpu", operations=ops)
+        x = torch.randn(3, 4, 16, 20)
+        kwargs = dict(context=torch.randn(3, 7, 16), y=torch.randn(3, 8))
+    else:
+        from comfy.ldm.qwen_image.model import QwenImageTransformer2DModel
+        model = QwenImageTransformer2DModel(patch_size=2, in_channels=16, out_channels=4, num_layers=2,
+                                            attention_head_dim=16, num_attention_heads=4, joint_attention_dim=16,
+                                            axes_dims_rope=(4, 6, 6), dtype=torch.float32, device="cpu", operations=ops)
+        x = torch.randn(3, 4, 1, 16, 20)
+        kwargs = dict(context=torch.randn(3, 7, 16))
+    with torch.no_grad():
+        for p in model.parameters():
+            p.copy_(torch.randn_like(p) * 0.05)
+    return model.eval(), x, torch.tensor([0.7, 0.4, 0.2]), kwargs
+
+
+def _worker(rank, world, comfy_path, store, family, results):
+    import torch.distributed as dist
+    _comfy(comfy_path)
+    dist.init_process_group("gloo", init_method=Path(store).as_uri(), rank=rank, world_size=world)
+    try:
+        from powershard.image_parallel import ParallelContext, install, run_parallel
+        torch.manual_seed(0)
+        model, x, t, kwargs = _build(family)
+        with torch.no_grad():
+            reference = model(x, t, transformer_options={}, **kwargs)
+            ctx = ParallelContext(world, rank)
+            ctx.min_tokens = 4
+            families = install(model, ctx)
+
+            def call(x_, t_, **kw):
+                return model(x_, t_, **kw)
+            seq, stats_seq = run_parallel(call, ctx, "sequence", x, (x, t), dict(kwargs, transformer_options={}))
+            batch, stats_batch = run_parallel(call, ctx, "batch", x, (x, t), dict(kwargs, transformer_options={}))
+        if rank == 0:
+            results.put(dict(families=families, seq=float((seq - reference).abs().max()),
+                             batch=float((batch - reference).abs().max()), modes=(stats_seq["mode"], stats_batch["mode"]),
+                             attention=stats_seq.get("attention_calls", 0)))
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.parametrize("family", ["flux", "qwen_image"])
+@pytest.mark.parametrize("world", [2, 3])
+def test_sequence_and_batch_parallel_match_reference(request, tmp_path, family, world):
+    comfy_path = request.config.getoption("--comfy")
+    if comfy_path is None:
+        pytest.skip("NOT_RUN: передайте --comfy")
+    import torch.multiprocessing as mp
+    ctx = mp.get_context("spawn")
+    results = ctx.Queue()
+    os.environ.setdefault("OMP_NUM_THREADS", "1")
+    procs = [ctx.Process(target=_worker, args=(r, world, comfy_path, str(tmp_path / "store"), family, results))
+             for r in range(world)]
+    for p in procs:
+        p.start()
+    for p in procs:
+        p.join(300)
+        assert p.exitcode == 0
+    out = results.get(timeout=10)
+    assert out["families"] and out["modes"] == ("sequence", "batch")
+    assert out["attention"] > 0
+    assert out["seq"] < 1e-4 and out["batch"] < 1e-5, out
diff --git a/tests/test_lifecycle_wan.py b/tests/test_lifecycle_wan.py
new file mode 100644
index 0000000..f060d25
--- /dev/null
+++ b/tests/test_lifecycle_wan.py
@@ -0,0 +1,211 @@
+"""Cancel / освобождение VRAM (powershard.lifecycle). Без torch/CUDA: реальные subprocess вместо ranks."""
+import os
+import queue
+import subprocess
+import sys
+import threading
+import time
+from types import SimpleNamespace
+import pytest
+from powershard.config import DistributedConfig
+
+HUNG_RANK = ("import signal, time\n"
+             "signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"   # зависший в NCCL rank: SIGTERM не помогает
+             "time.sleep(120)\n")
+
+
+def hung_process():
+    return subprocess.Popen([sys.executable, "-c", HUNG_RANK], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                            text=True, start_new_session=True)
+
+
+@pytest.fixture
+def lifecycle():
+    from powershard import lifecycle
+    lifecycle.install()
+    return lifecycle
+
+
+def make_session(tmp_path, keep=True):
+    from powershard.runtime import Session
+    session = Session(None, DistributedConfig(weight_placement="cpu", release_after_sampling=not keep), tmp_path, tmp_path)
+    session.path = tmp_path / "workers"
+    session.path.mkdir(exist_ok=True)
+    return session
+
+
+def test_reap_kills_rank_that_ignores_shutdown_and_sigterm(lifecycle):
+    proc = hung_process()
+    time.sleep(.3)
+    started = time.monotonic()
+    assert lifecycle.reap([proc], grace=.2) == []
+    assert proc.poll() is not None and time.monotonic() - started < 20
+
+
+def test_drain_has_deadline_and_releases_hung_ranks(lifecycle, tmp_path, monkeypatch):
+    monkeypatch.setenv("POWERSHARD_DRAIN_TIMEOUT_S", "1")
+    session = make_session(tmp_path)
+    proc = hung_process()
+    session.processes, session.responses = [proc], [queue.Queue()]
+    session.sequence = 1
+    session._drain_done.clear()
+    staging, out = tmp_path / "in", tmp_path / "out"
+    staging.mkdir()
+    with pytest.warns(UserWarning, match="дренаж"):
+        thread = threading.Thread(target=session._drain_cancelled, args=(1, staging, out))
+        thread.start()
+        assert session._drain_done.wait(30)
+        thread.join(5)
+    assert proc.poll() is not None and session.processes == [] and not staging.exists()
+
+
+def test_second_cancel_while_draining_forces_reset(lifecycle, tmp_path, monkeypatch):
+    monkeypatch.setenv("POWERSHARD_DRAIN_TIMEOUT_S", "3600")
+    session = make_session(tmp_path)
+    proc = hung_process()
+    session.processes, session.responses = [proc], [queue.Queue()]
+    session._drain_done.clear()
+    staging, out = tmp_path / "in", tmp_path / "out"
+    staging.mkdir()
+    thread = threading.Thread(target=session._drain_cancelled, args=(1, staging, out))
+    thread.start()
+
+    def cancel():
+        raise InterruptedError("второй Cancel")
+    with pytest.warns(UserWarning):
+        with pytest.raises(InterruptedError):
+            session.wait_for_drain(cancel)
+        assert session._drain_done.wait(30)
+        thread.join(5)
+    assert proc.poll() is not None and session.processes == []
+
+
+def test_close_never_raises_and_resets_state(lifecycle, tmp_path):
+    from powershard import runtime
+    session = make_session(tmp_path, keep=False)
+    session.processes = [hung_process(), hung_process()]
+    runtime._ACTIVE = session
+    session.close()
+    assert session.processes == [] and session.path is None and runtime._ACTIVE is None
+
+
+def wan_session(tmp_path, keep):
+    from powershard.wan_runtime import WanSession
+    session = WanSession(None, DistributedConfig(weight_placement="cpu", release_after_sampling=not keep), tmp_path,
+                         tmp_path, role_options={"experts": {"high": "h", "low": "l"}})
+    session.processes = [SimpleNamespace(poll=lambda: None)]
+    calls = []
+    session.control = lambda command: calls.append(command)
+    session.close = lambda **kw: calls.append("close")
+    session.idle = lambda: calls.append("idle")
+    return session, calls
+
+
+@pytest.mark.parametrize("keep", [True, False])
+def test_interrupted_high_noise_pass_is_not_deferred(lifecycle, tmp_path, keep):
+    session, calls = wan_session(tmp_path, keep)
+    session.note_expert("high")
+    session.finish_sampling()                       # успешный high-only проход: ждём low (VRAM остаётся)
+    assert calls == ["end_run"] and session._wan_deferred
+    calls.clear()
+    session.note_expert("high")
+    session.__dict__["_ps_run_failed"] = True       # Cancel внутри high-noise прохода
+    session.finish_sampling()
+    assert calls == ["end_run", "idle" if keep else "close"] and not session._wan_deferred
+    assert session._wan_run_slots == set()
+
+
+def test_prompt_end_settles_deferred_session(lifecycle, tmp_path, monkeypatch):
+    from powershard import runtime
+    session, calls = wan_session(tmp_path, keep=False)
+    session.note_expert("high")
+    session.finish_sampling()
+    calls.clear()
+    monkeypatch.setattr(runtime, "_SESSIONS", [session])
+    lifecycle.settle_deferred_sessions()            # задача закончилась без low-noise прохода
+    assert calls == ["end_run", "close"] and not session._wan_deferred
+
+
+def test_drain_clears_stale_expert_slots(lifecycle, tmp_path):
+    session, calls = wan_session(tmp_path, keep=True)
+    session.note_expert("high")
+    session._drain_done.clear()
+    session.finish_sampling()
+    session._drain_done.set()
+    assert session._wan_run_slots == set() and calls == []
+
+
+def test_boundary_wrapper_marks_failure_and_resets_block_cache(lifecycle):
+    from powershard.accel import BlockCacheHolder
+    holder = BlockCacheHolder(.1, .9, .1, 2, 1)
+    holder.last_sigma, holder.steps = .3, 7
+    session = SimpleNamespace()
+    guider = SimpleNamespace(model_patcher=SimpleNamespace(session=session),
+                             model_options={"transformer_options": {"powershard_block_cache": holder}})
+
+    def failing(*args, **kwargs):
+        raise InterruptedError()
+    with pytest.raises(InterruptedError):
+        lifecycle.boundary_outer_sample(_Executor(guider, failing))
+    assert session._ps_run_failed and holder.last_sigma is None and holder.steps == 0
+    assert lifecycle.boundary_outer_sample(_Executor(guider, lambda: "ok")) == "ok"
+    assert session._ps_run_failed is False
+
+
+class _Executor:
+    def __init__(self, guider, function):
+        self.class_obj, self.function = guider, function
+
+    def __call__(self, *args, **kwargs):
+        return self.function(*args, **kwargs)
+
+
+def test_unload_all_models_releases_every_session(lifecycle, tmp_path, monkeypatch):
+    from powershard import runtime
+    released = []
+    sessions = [SimpleNamespace(processes=[1], _drain_done=threading.Event(), close=lambda: released.append(1)),
+                SimpleNamespace(processes=[], _drain_done=threading.Event(), close=lambda: released.append(2))]
+    for s in sessions:
+        s._drain_done.set()
+    monkeypatch.setattr(runtime, "_SESSIONS", sessions)
+    lifecycle.release_sessions()
+    assert released == [1]
+
+
+@pytest.mark.skipif(os.name != "posix", reason="process groups")
+def test_reap_on_already_exited_process(lifecycle):
+    proc = subprocess.Popen([sys.executable, "-c", "pass"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
+                            start_new_session=True)
+    proc.wait(10)
+    assert lifecycle.reap([proc]) == []
+
+
+def test_request_abort_on_fresh_session_does_not_deadlock(lifecycle):
+    session = SimpleNamespace(_drain_done=threading.Event())   # дренаж только что начат, Event abort ещё не создан
+    done = threading.Event()
+    threading.Thread(target=lambda: (lifecycle.request_abort(session), done.set()), daemon=True).start()
+    assert done.wait(5) and session._ps_abort.is_set()
+
+
+def test_abort_without_drain_is_cleared_by_close(lifecycle, tmp_path):
+    session = make_session(tmp_path)
+    session._drain_done.clear()
+    lifecycle.request_abort(session)
+    session._drain_done.set()                         # дренаж так и не стартовал (runtime.py: thread не создан)
+    session.close()
+    assert not session._ps_abort.is_set()             # следующий штатный дренаж не будет убит
+
+
+def test_cancel_file_reaches_worker_check(lifecycle, tmp_path):
+    """Cancel: host пишет <session>/cancel с номером команды, worker видит его только для этой команды."""
+    from powershard import cancel
+    session = SimpleNamespace(path=tmp_path)
+    cancel.configure(str(tmp_path), None)
+    cancel.begin(7)
+    assert not cancel.requested_locally()
+    lifecycle.request_step_cancel(session, 6)            # старая команда — не прерывает текущую
+    assert not cancel.requested_locally()
+    lifecycle.request_step_cancel(session, 7)
+    assert cancel.requested_locally()
+    cancel.end()
+    assert not cancel.requested_locally()
