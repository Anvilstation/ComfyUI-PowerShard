++def read_quant_json(path, data_start, desc):
++    a, b = desc["data_offsets"]
++    if desc["dtype"] != "U8" or b - a > 1 << 20:
++        raise ValueError("Неверные comfy_quant metadata")
++    with open(path, "rb") as f:
++        f.seek(data_start + a)
++        return json.loads(f.read(b - a))
