+        options = {k: v for k, v in self.model_options.get("transformer_options", {}).items()
+                   if k not in INTERNAL_KEYS + ("rope_options", "animate2_cache", "callbacks") + HOST_ONLY_TRANSFORMER_KEYS}
+        if "wrappers" in options:
