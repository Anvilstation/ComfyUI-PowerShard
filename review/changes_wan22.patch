++@dataclasses.dataclass
++class QuantPlan:
++    fmt: str
++    layout: object
++    params_cls: type
++    fields: dict
++    specs: list          # [(имя, dtype, shape, offset, nbytes)], первым — "_qdata"
++    total: int
++    source: dict         # kind=file|quantize, module, key(s), ...
++
++    def signature(self):
++        return [(n, str(d), list(s), o, b) for n, d, s, o, b in self.specs]
