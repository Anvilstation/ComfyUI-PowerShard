++def _strip_own(wrappers):
++    out = {}
++    for kind, keyed in (wrappers or {}).items():
++        out[kind] = {}
++        for key, functions in keyed.items():
++            kept = [f for f in functions if not (kind == "prepare_sampling" and key == "powershard"
++                                                 and f is image_guard_sampling)]
++            if kept:
++                out[kind][key] = kept
++    return out
