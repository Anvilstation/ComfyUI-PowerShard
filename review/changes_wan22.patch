+
+def wandancer_14b(name):
+    graph = single(common(), "wan2.2_wandancer_14B_fp16.safetensors")
+    graph["8"] = node("VAELoader", vae_name="wan_2.1_vae.safetensors")
+    graph["9"] = node("LoadImage", image="dancer.png")
