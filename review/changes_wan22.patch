++def cpu_start(self, cancel=None):
++    from powershard import runtime
++    if self.running:
++        if runtime._ACTIVE is not None and runtime._ACTIVE is not self:
++            runtime._ACTIVE.deactivate()
++        runtime._ACTIVE = self
++        self.idle_on_cpu = False
++        return
